# Cấu hình Database MySQL (dùng driver aiomysql)
DATABASE_URL=mysql+aiomysql://root:@localhost:3306/vtv_key_sellers

# Khóa API Google Gemini (Lấy miễn phí tại https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Lần đầu khởi động đặt True để nạp vector chính sách, sau đó đổi thành False
RESET_CHROMA_DB=True

# Thư mục lưu trữ cơ sở dữ liệu vector ChromaDB
CHROMA_DB_PATH=./chroma_db_data

# Chế độ Debug
DEBUG=True
